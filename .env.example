ANTHROPIC_ADMIN_API_KEY=sk-ant-admin-...
CLAUDE_PLAN=Pro
MONTHLY_TOKEN_LIMIT=10000000

# Shared secret that sync agents send as a Bearer token. Generate with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
REMOTE_TOKEN=

# Bind address. Defaults to 127.0.0.1 (localhost only).
# Set to 0.0.0.0 to expose on your local network (e.g. for multi-machine sync).
HOST=127.0.0.1
PORT=5000

# ── TLS ──────────────────────────────────────────────────────────────────────
# off          Plain HTTP (default).
# self-signed  Generate a private CA + server certificate in TLS_CERT_DIR and
#              serve HTTPS only. Copy TLS_CERT_DIR/ca.pem to each sync agent.
# custom       Serve HTTPS only using an externally managed certificate.
TLS_MODE=off

# self-signed: extra hostnames / IPs agents use to reach the hub (comma-separated).
# localhost, 127.0.0.1, ::1 and this machine's hostname are always included.
# Changing this re-issues the server certificate; the CA stays the same.
TLS_HOSTNAMES=
# self-signed: where the CA and server certificate are kept (default ./certs).
TLS_CERT_DIR=

# custom: PEM certificate (full chain) and private key.
TLS_CERT_FILE=
TLS_KEY_FILE=
